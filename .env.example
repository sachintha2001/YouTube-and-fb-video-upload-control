# Optional fallback credentials for local development.
# In production, you can configure these directly inside the app's "API Credentials" modal,
# which encrypts them at rest using OS-level keychain storage (macOS Keychain / Windows DPAPI).

OAUTH_REDIRECT_PORT=53682

# Google Cloud Console -> OAuth 2.0 Client ID (Desktop App or Web App with http://localhost:53682/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers -> App ID & App Secret (Valid OAuth Redirect URI: http://localhost:53682/oauth/facebook/callback)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

